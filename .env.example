# ============================================
# StoryVid - AI Story Video
# 复制此文件为 .env 并填入你的 API Keys
# cp .env.example .env
# ============================================

# --- LLM 大语言模型（必填，用于生成故事稿）---

# 支持任意 OpenAI 兼容 API: DeepSeek / Kimi / OpenAI / 通义千问 等
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- TTS 语音合成（必填，选一个提供商）---

# 提供商: stepfun / minimax / volc / edge（edge=微软神经语音，免费无需 Key，联网即用，自带词级时间戳） / volc
TTS_PROVIDER=stepfun

# 选项A: StepFun（阶跃星辰）TTS
# 注册获取: https://platform.stepfun.com
# model 可选: step-tts-mini / step-tts-2 / stepaudio-2.5-tts（以官方文档为准）
STEPFUN_API_KEY=your_stepfun_api_key_here
TTS_MODEL=step-tts-2
TTS_VOICE=cixingnansheng
TTS_SPEED=1.15
TTS_VOLUME=1.0
TTS_SAMPLE_RATE=24000

# 选项B: MiniMax TTS（TTS_PROVIDER=minimax 时生效）
# 注册获取: https://platform.minimaxi.com
# speech-01-hd 之外也可以试 speech-02-hd / speech-2.5 系列（以官方文档为准）
MINIMAX_TTS_MODEL=speech-01-hd
MINIMAX_TTS_VOICE_ID=male-qn-jingying
MINIMAX_TTS_SPEED=1.15

# 选项C: 火山引擎（豆包）TTS（TTS_PROVIDER=volc 时生效）
# 注册获取: 火山引擎控制台「语音技术-应用管理」创建应用，拿 AppID 与 Access Token
#   https://console.volcengine.com/speech/app
# 官方接口文档: https://www.volcengine.com/docs/6561/79820（HTTP 非流式合成）
# 【需真 key 实测】本接入按公开文档结构实现，尚未用真实 key 验证过；
# AppID/Token/cluster/音色需与你在控制台开通的服务一致（volcano_tts 为小模型集群）。
VOLC_TTS_APPID=your_volc_tts_appid_here
VOLC_TTS_TOKEN=your_volc_tts_token_here
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_VOICE_TYPE=BV001_streaming
# 接口地址一般不用改；大模型音色/集群以控制台为准
#VOLC_TTS_API_URL=https://openspeech.bytedance.com/api/v1/tts
#VOLC_TTS_ENCODING=mp3
#VOLC_TTS_SPEED_RATIO=1.0
#VOLC_TTS_VOLUME_RATIO=1.0

# 选项C: Edge TTS（免费无 Key，推荐先用它验证全流程）
#TTS_PROVIDER=edge
#EDGE_TTS_VOICE=zh-CN-YunxiNeural

# voice_label: 语言/情绪/风格，三选一，JSON 格式（仅 StepFun）
# 示例: {"emotion":"高兴"} 或 {"language":"粤语"} 或 {"style":"慢速"}
#TTS_VOICE_LABEL={"emotion":"高兴"}

# instruction: 全局自然语言指导（仅 stepaudio-2.5-tts 支持）
#TTS_INSTRUCTION=用沉稳的纪录片腔调朗读

# --- TTS 时间戳对轴（默认开；字幕按真实发音边界切块，替代字符比例估时）---
# 生成配音时顺带取真实时间片：StepFun 走流式 WS 词级、MiniMax 开字幕取句级、
# 火山带 with_timestamp 取字级（音频仍走原接口）。注意：开启后每段配音会多
# 一次对应 provider 的 TTS 调用用于取时间戳；任何失败自动回退字符比例，
# 不影响出片。断点续跑复用的旧音频没有时间戳（由本地对齐兜底，见下节）。
#TTS_TIMESTAMPS=1
# StepFun 流式语音合成 WebSocket 入口（词级时间戳；一般不用改）
#STEPFUN_WS_URL=wss://api.stepfun.com/v1/realtime/audio

# --- 词级时间戳兜底对齐（可选；不装引擎完全不影响出片）---
# TTS 未返回词级时间戳时（含断点续跑复用的旧音频），用本地 Whisper 系引擎
# 对配音 mp3 做词级对齐（纯本地推理，无需任何 API Key），供逐词高亮字幕等
# 能力使用。本程序绝不自动安装依赖：引擎未安装时打印安装指引并优雅跳过。
# ALIGNER=auto（默认，自动检测已装引擎）/ off（关闭）
#        / faster-whisper / whisper-timestamped（强制指定引擎，未装同样跳过）
# 任装其一：  pip install faster-whisper（推荐，较轻无 torch）
#            pip install openai-whisper whisper-timestamped（较重，含 torch）
#ALIGNER=auto
# whisper 模型尺寸：tiny/base/small/medium/large-v3（越大越准越慢）
#ALIGNER_MODEL=small
# 识别语言：默认 zh（本管线以中文为主）；设 auto 让引擎自动检测
#ALIGNER_LANGUAGE=zh

# --- AI 配图（可选；不配也能跑，会退回备用随机图）---

# 图片来源: minimax / unsplash / local
IMAGE_SOURCE=minimax

# 选项A: MiniMax AI 生图
# 注册获取: https://platform.minimaxi.com
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_IMAGE_MODEL=image-01
# 每段生图候选数（1-9，默认 1）：>1 时除主图 image_XXX.jpg 外其余候选落盘
# image_XXX_alt_N.jpg，供 Web /api/candidates 列候选、/api/select 一键换图
MINIMAX_IMAGE_N=1

# 选项B: Unsplash 免费图库
# 注册获取: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# 选项C: 本地图片目录（从里面随机取图）
LOCAL_IMAGE_DIR=./local_images

# 本地素材优先目录（用户自备照片/视频，CLI --media-dir 与 Web「本地素材目录」同效）：
# 递归扫描其中的图片（jpg/jpeg/png/webp）与视频（mp4/mov/webm/mkv/avi）。
# 配置且含可用素材时优先使用（照片自动配到各段，视频截取到该段配音时长并静音），
# 未覆盖到的段照旧走上面的云端配图降级链；单文件上限 200MB
#LOCAL_MEDIA_DIR=/home/you/Pictures/小区素材

# --- 视频与字幕设置 ---

# 输出/临时目录根（pipx 等安装版用户建议设置）：设置后 视频输出(output/) 与
# 临时文件(temp/) 都写到 $STORYVID_HOME 下；不设置时跟随安装位置
# （源码运行 = 仓库根，pipx 安装 = pipx 虚拟环境内部，升级重装会清掉历史视频）
#STORYVID_HOME=/home/you/storyvid-data

# 画面比例: 16:9（横屏/B站）或 9:16（竖屏/抖音）
ASPECT_RATIO=9:16

# 视频帧率
#VIDEO_FPS=24

# 演示模式: DEMO=1 与 CLI --demo 同效——零 Key 全离线出片（内置示例文稿 +
# 每段 3 秒静音配音 + PIL 渐变大字占位图），不调搜索/审核/LLM/TTS/配图任何 API；
# 默认按预览分辨率快速渲染，显式设 PREVIEW=0 可用全分辨率
#DEMO=0

# 字幕单块最大字符数（一句话超过会按逗号再切）
#SUBTITLE_MAX_CHARS=42

# 字幕样式: plain（默认，底部黑条白字）/ card（圆角卡片条，数字与引号关键词主题色高亮）/
#          karaoke（逐词卡拉OK：已唱/当前词主题色高亮。词级时间戳（TTS_TIMESTAMPS
#          或本地对齐）驱动，缺失时块内按字符比例）
#SUBTITLE_STYLE=plain

# card/karaoke 主题色（HEX）：card 的描边与关键词、karaoke 的高亮词
#SUBTITLE_THEME_COLOR=#FFCD5A

# 指定中文字体文件路径；留空自动探测（找不到中文字体时字幕会变方块）
#FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# 片头片尾卡：开头插 1.8s 渐变+主题大字片头卡，结尾插 1.5s 引导关注片尾卡
# （短视频前 3 秒是完播率关键，卡片不宜久留）
# 默认开启；设 0/false/off/no 关闭（关闭后字幕时间轴不受影响）
#INTRO_OUTRO=1

# 片头卡文案；留空时用视频主题作大字
#INTRO_TEXT=

# 片尾卡文案；留空用内置默认引导关注文案
#OUTRO_TEXT=

# 段间交叉淡化秒数：相邻故事片段画面淡入 + 音频同步淡入淡出
# 默认 0.6 = 相邻段重叠 0.6 秒平滑过渡（转场更自然、成片更紧凑；
# 重叠区字幕已做窗口化，前段字幕提前收起，不会出现两层字幕叠画）。
# 设 0 = 关闭（硬切）。开启后成片时长 = 各段之和 - 段间重叠，
# SRT 字幕时间轴自动同步前移
#CROSSFADE_SECONDS=0.6

# 背景音乐（柔和氛围垫乐）：用 imageio-ffmpeg 自带 ffmpeg 离线合成，无需任何 API Key
# BGM_VOLUME 垫乐总音量 0~1：默认 0 = 关闭；推荐 0.15~0.35（垫乐音量低，配音不被盖过）
#BGM_VOLUME=0.2

# 垫乐风格（温度感）: warm（默认·暖夜） / cool（清凉·稍亮） / deep（低沉·氛围暗）
#BGM_TEMP=warm

# 用户自备曲库目录（任务 D7）：指向本地曲目文件夹（递归扫描 .mp3/.wav）。
# 有可用曲库时优先从曲库选曲（同一项目当日固定一首不重复，跨天随机换曲），
# 无曲库才回退合成垫乐；音量跟随 BGM_VOLUME，BGM_VOLUME=0 时按 0.25 自动开启
#BGM_DIR=./my_music

# 封面标题文案（覆盖视频主题作为封面大标题；留空用主题）
#COVER_TITLE=

# --- Web 服务设置 ---

# 默认只监听本机；如需局域网访问改成 0.0.0.0
#WEB_HOST=127.0.0.1
#WEB_PORT=5000
